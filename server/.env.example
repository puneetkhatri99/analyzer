DATABASE_URL=postgresql://user:password@127.0.0.1:5432/analyser
# Only needed if a dashboard on another address calls this API (CORS). The built-in dashboard shares its address.
ALLOWED_ORIGIN=*
# Admin panel (/admin): AI extraction of jobs from any URL. Create admins with: python -m app.cli create-admin <email>
OPENAI_API_KEY=
# "production" on Render. With AXIOM_TOKEN set too, logs go to Axiom only and no log files are written.
APP_ENV=local
# Outgoing email (EMAIL.md): any SMTP server. Resend: smtp.resend.com / 465 / user "resend" / password = the re_... key.
# The from address must be one the server may send from (for Resend: on a verified domain).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=MinistryHub Leads <alerts@ministryhub.org>
SITE_URL=http://localhost:5173
# Sign-ups from these domains (your own team testing) aren't stored as leads. Comma-separated.
IGNORED_LEAD_DOMAINS=ministryhub.org
# Daily feed job: the link is saved in Admin -> Settings; FEED_URL is only the fallback. See DAILY_FEED.md.
FEED_URL=
FEED_HOUR_UTC=6
ENRICH_MAX_PER_RUN=50
# Optional: override the log level (API default INFO, scripts DEBUG), e.g. DEBUG to look into a problem.
LOG_LEVEL=

# Optional: also send every log line to Axiom (https://axiom.co). Without a token, logs stay in server/logs/ only.
AXIOM_TOKEN=
AXIOM_DATASET=analyzer
# push-data only: the hosted database's direct (non-pooler) connection string
NEON_URL=
