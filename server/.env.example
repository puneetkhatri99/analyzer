DATABASE_URL=postgresql://user:password@127.0.0.1:5432/analyser
# Optional: enables LLM title classification + denomination/size extraction in the pipeline
ANTHROPIC_API_KEY=
# Only needed if a dashboard on another address calls this API (CORS). The built-in dashboard shares its address.
ALLOWED_ORIGIN=*
# Admin panel (/admin): AI extraction of jobs from any URL. Create admins with: python -m pipeline.create_admin <email>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
