# Copy to ../.env on the server (cp deploy/env.example .env; chmod 600 .env). Never commit it.
# Letters and digits only in the password (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Empty = apply every migration. A number holds newer ones back (a destructive one waits for a manual run).
MIGRATE_UP_TO=

SITE_URL=https://yourdomain.org
ALLOWED_ORIGIN=https://yourdomain.org

OPENAI_API_KEY=

# Outgoing email (EMAIL.md). Resend: smtp.resend.com / 465 / resend / the re_... key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
ALERT_FROM_EMAIL=MinistryHub Leads <alerts@yourdomain.org>

IGNORED_LEAD_DOMAINS=ministryhub.org
# Private BizDev sheets (DEPLOY_EC2.md, "Private Google Sheets"): uncomment once secrets/google-key.json is in place.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-key.json
# Optional, as in server/.env.example: AXIOM_TOKEN, MAILCHIMP_API_KEY, MAILCHIMP_LIST_ID, FEED_URL, FEED_HOUR_UTC
